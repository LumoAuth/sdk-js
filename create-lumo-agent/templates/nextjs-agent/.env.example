# LumoAuth instance domain — the ROOT host, not the /orgs/... path.
# Copy from your LumoAuth dashboard.
NEXT_PUBLIC_LUMOAUTH_DOMAIN={{domain}}

# Your organization id (e.g. "acme-corp").
NEXT_PUBLIC_LUMOAUTH_ORG_ID={{orgId}}

# OAuth client id (public — used by the browser to start the sign-in flow).
NEXT_PUBLIC_LUMOAUTH_CLIENT_ID={{clientId}}

# Agent access token (server-only). Used to call the LumoAuth API on the
# agent's behalf (permission checks + push approvals). Mint one from your
# dashboard: AI Agents → your agent → Token.
LUMOAUTH_AGENT_TOKEN=
