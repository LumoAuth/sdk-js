{
  "name": "@lumoauth/nextjs",
  "version": "1.4.2",
  "description": "LumoAuth for Next.js — server-side auth() for App Router, route protection middleware, and a backend-for-frontend that keeps tokens out of the browser.",
  "license": "MIT",
  "author": "LumoAuth",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && tsup src/session-cookie.ts src/config.ts src/origin.ts src/route-handler.ts --format esm -d tests/.build --silent && node --test tests/*.test.mjs"
  },
  "keywords": [
    "lumoauth",
    "nextjs",
    "next",
    "authentication",
    "app-router",
    "rsc",
    "middleware"
  ],
  "dependencies": {
    "@lumoauth/client": "^1.4.2",
    "@lumoauth/react": "^1.4.2",
    "@lumoauth/shared": "^1.4.2",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "next": "^16.4.4",
    "react": "^19.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
