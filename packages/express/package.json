{
    "name": "@lumoauth/express",
    "version": "1.0.0",
    "description": "Express middleware for LumoAuth \u2014 login, callback, and logout routes plus requireAuth().",
    "license": "MIT",
    "author": "LumoAuth",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "lumoauth",
        "express",
        "middleware"
    ],
    "dependencies": {
        "@lumoauth/backend": "^1.0.0",
        "@lumoauth/shared": "^1.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "tsup": "^8.0.0",
        "typescript": "^5.5.0",
        "@types/express": "^4.17.21",
        "@types/express-session": "^1.18.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false,
    "peerDependencies": {
        "express": ">=4.18.0",
        "express-session": ">=1.17.0"
    }
}
