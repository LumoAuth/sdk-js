{
    "name": "@lumoauth/react",
    "version": "1.4.2",
    "description": "Official LumoAuth React SDK — Drop-in authentication components and hooks for React & Next.js applications.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && tsup --entry.Protect src/components/Protect.tsx --entry.UserProfile src/components/UserProfile.tsx --entry.styles src/styles.ts --clean --no-config --format esm -d tests/.build --silent --external react --external react-dom --external @lumoauth/client && node --test tests/*.test.mjs",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "lumoauth",
        "react",
        "nextjs",
        "authentication",
        "authorization",
        "sign-in",
        "oauth",
        "oidc",
        "rbac",
        "abac",
        "zanzibar",
        "drop-in",
        "components"
    ],
    "author": "LumoAuth",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "dependencies": {
        "@lumoauth/client": "^1.4.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "tsup": "^8.0.0",
        "typescript": "^5.5.0"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "sideEffects": false
}
